# E13 labeler image (NFR-10). Build from the repository root:
#   podman build -f deploy/Containerfile --build-arg E13_APP_COMMIT=$(git rev-parse --short=12 HEAD) -t e13-labeler .
# It serves plain HTTP on 8000; put it behind the HTTPS proxy in compose.yaml (NFR-5, §11 Q5).
FROM docker.io/library/python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    E13_OUTPUTS=/data \
    PYTHONUNBUFFERED=1

WORKDIR /app
# Dependencies first, so code changes don't reinstall them
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY e13_labeler ./e13_labeler
COPY run.sh README.md ./
RUN uv sync --frozen --no-dev

# No git in the image: the commit recorded on every annotation (NFR-7) comes from the build
ARG E13_APP_COMMIT=""
ENV E13_APP_COMMIT=${E13_APP_COMMIT}

RUN useradd --system --uid 10013 --home /data e13 && mkdir -p /data && chown e13 /data
USER e13
VOLUME /data
EXPOSE 8000

# Bind all interfaces inside the container; only the proxy can reach it (compose.yaml)
CMD ["python", "-m", "e13_labeler", "serve", "--host", "0.0.0.0", "--port", "8000"]
