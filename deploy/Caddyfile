# HTTPS for external labelers (NFR-5, §11 Q5). Caddy gets and renews a
# certificate for E13_DOMAIN automatically (the name must resolve to this host
# and ports 80/443 must be reachable). It sets X-Forwarded-For itself; the app
# believes it only because TRUSTED_PROXIES names this proxy's address.
{$E13_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
}
